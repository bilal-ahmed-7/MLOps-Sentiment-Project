# Copy to .env and fill in values. .env is git-ignored; never commit real values.
# Docker Compose reads .env automatically for ${VARIABLE} substitution.
# This file lists variable NAMES only.

# --- Docker Compose (local MLflow + Postgres) ---
# If empty, docker-compose.yml falls back to a local-only default password.
# Use URL-safe characters. If the Postgres volume already exists, keep the same password.
MLFLOW_DB_PASSWORD=

# --- Training / registry (set in your shell, e.g. $env:MLFLOW_TRACKING_URI in PowerShell) ---
MLFLOW_TRACKING_URI=

# --- API (optional overrides; see src/serving/model_loader.py) ---
MODEL_SOURCE=
MODEL_PATH=
MODEL_NAME=
MODEL_ALIAS=
PORT=

# --- DagsHub (DVC remote) - GitHub Actions uses repository secrets with these names ---
DAGSHUB_USER=
DAGSHUB_TOKEN=

GRAFANA_ADMIN_PASSWORD=
PUSHGATEWAY_URL=http://localhost:9091
